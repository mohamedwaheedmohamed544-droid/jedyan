{
  "pages": {
    "/(ar)/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(ar)/layout.css",
      "static/chunks/app/(ar)/layout.js"
    ],
    "/(ar)/template": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(ar)/template.js"
    ],
    "/(ar)/[[...slug]]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(ar)/[[...slug]]/page.css",
      "static/chunks/app/(ar)/[[...slug]]/page.js"
    ]
  }
}